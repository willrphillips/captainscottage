# Dependencies
node_modules/

# Build output
dist/
.astro/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local photo source library (large originals; not served — only processed
# outputs in public/images/ are committed). Re-run scripts/process-photos.mjs
# locally against these.
additional images/
photos/
_inbox/

# Nightly harvester run logs (local to the Ubuntu box)
.harvest-logs/

# Local secrets + ephemeral runtime (the Ubuntu box)
scripts/.captainscottage.env
runtime/

# Interrupted atomic-write temp artifacts (e.g. foo.mjs.tmp.1234.abcd)
*.tmp.*

# Local Claude Code machine config / runtime — NOT for this public repo
# (agents/ and workflows/ under .claude/ stay tracked; these do not)
.claude/settings.json
.claude/settings.local.json
.claude/skills/
.claude/scheduled_tasks.lock

# Private source documents — keep out of the public repo (originals live in
# the Dropbox-synced workspace). The Airbnb guidebook PDF is transcribed into
# src/lib/guidebook.ts; that transcription is the public artifact, not the PDF.
/*.pdf
airbnb-photo-update-cowork-prompt.md

# Raw mined Airbnb guest Q&A source — may contain guest-identifying detail.
# The anonymized, publishable derivatives live in content/replies/.
content/airbnb-archive/
*.log
*.tmp
.flowstatus.json

# Pinterest OAuth token, minted locally by scripts/pinterest-auth.mjs. Never commit.
.pinterest-token.local
