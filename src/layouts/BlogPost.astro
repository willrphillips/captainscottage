---
import BaseLayout from "~/layouts/BaseLayout.astro";
import SchemaBlogPosting from "~/components/SchemaBlogPosting.astro";
import BlogCard from "~/components/BlogCard.astro";
import ReviewPanel from "~/components/ReviewPanel.astro";
import { formatDateUTC, withBase } from "~/lib/site";

interface RelatedPost {
  title: string;
  description: string;
  category: "Lifestyle" | "Travel" | "Real Estate";
  slug: string;
  publishedAt: Date;
}

type AudienceTag =
  | "family"
  | "romantic"
  | "outdoor"
  | "food"
  | "seasonal"
  | "remote-work";

interface Props {
  title: string;
  description: string;
  category: "Lifestyle" | "Travel" | "Real Estate";
  slug: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  keywords?: string[];
  readingMinutes: number;
  related?: RelatedPost[];
  isDraft?: boolean;
  previewMode?: boolean;
  audience?: AudienceTag[];
  approvedAt?: Date | null;
  hero?: string;
  heroAlt?: string;
}

const {
  title,
  description,
  category,
  slug,
  publishedAt,
  updatedAt,
  author,
  keywords = [],
  readingMinutes,
  related = [],
  isDraft = false,
  previewMode = false,
  audience = [],
  approvedAt = null,
  hero,
  heroAlt = "",
} = Astro.props;

const AUDIENCE_LABELS: Record<AudienceTag, string> = {
  family: "Family",
  romantic: "Romantic",
  outdoor: "Outdoor",
  food: "Food & kitchen",
  seasonal: "Seasonal",
  "remote-work": "Remote work",
};

const dateLabel = formatDateUTC(publishedAt);

const isoDate = publishedAt.toISOString();
const pathname = `/journal/${slug}`;
---

<BaseLayout
  title={title}
  description={description}
  pathname={pathname}
  ogImage={hero}
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Journal", href: "/journal" },
    { name: title, href: pathname },
  ]}
>
  <SchemaBlogPosting
    slot="head"
    title={title}
    description={description}
    slug={slug}
    publishedAt={publishedAt}
    updatedAt={updatedAt}
    author={author}
    image={hero}
    keywords={keywords}
  />

  <article class="section-pad">
    <div class:list={[previewMode ? "mx-auto max-w-[1400px] px-6 md:px-10" : "container-narrow"]}>
      <div class:list={[previewMode ? "lg:grid lg:grid-cols-[minmax(0,1fr)_380px] lg:gap-12" : ""]}>
        {/* Article column (everything that ships to production) */}
        <div>
          <header class="reveal max-w-[44rem]">
            {
              isDraft && previewMode && (
                <p class="mb-6 inline-block rounded-full border border-rust bg-rust/10 px-4 py-1 text-xs font-medium uppercase tracking-[0.18em] text-rust-deep">
                  Draft preview — not live · review only
                </p>
              )
            }
            <p class="eyebrow">{category}</p>
            <h1 class="mt-6 font-display display-lg leading-[1.05]">{title}</h1>
            <p class="lede mt-8">{description}</p>
            <p class="mt-8 text-sm text-ink-soft">
              By {author} ·{" "}
              <time datetime={isoDate}>{dateLabel}</time> ·{" "}
              {readingMinutes} min read
            </p>
            {
              audience.length > 0 && (
                <ul class="mt-5 flex flex-wrap gap-2">
                  {audience.map((tag) => (
                    <li class="rounded-full border border-rule px-3 py-1 text-xs uppercase tracking-[0.14em] text-ink-soft">
                      {AUDIENCE_LABELS[tag]}
                    </li>
                  ))}
                </ul>
              )
            }
          </header>

          {
            hero && (
              <figure class="reveal mt-12 overflow-hidden bg-bone-deep">
                <img
                  src={withBase(hero)}
                  alt={heroAlt}
                  class="h-auto w-full"
                  loading="eager"
                  fetchpriority="high"
                  decoding="async"
                />
              </figure>
            )
          }

          <div class="reveal mt-16 h-px bg-rule max-w-[44rem]"></div>

          <div class:list={["body-prose post-body reveal mt-16 max-w-[44rem]", previewMode ? "" : "mx-auto"]}>
            <slot />
          </div>

          {/* The per-post body now carries its own closing CTA (Writer
              directive). The old "Stay with us / The water is waiting" CTA
              block lived here with a top border bar — removed at Will's
              request so the post reads as one continuous voice. */}

          {/* Author bio — E-E-A-T signal. Lives below the body, above related. */}
          <aside class:list={["reveal mt-20 max-w-[44rem] text-sm text-ink-soft", previewMode ? "" : "mx-auto"]}>
            <p class="eyebrow">Written by</p>
            <p class="mt-3">
              <strong class="text-ink">{author}</strong> — host of Captain's Cottage on Hull Creek, Virginia's Northern Neck. Notes are first-hand from a property owned and operated since 2022. Questions <a href="https://www.airbnb.com/h/captainscottageva" rel="noopener" target="_blank" class="text-rust">message us through Airbnb</a>.
            </p>
          </aside>
        </div>

        {/* Review column — sticky pane that scrolls independently. Only
            in previewMode; never rendered in the production build. */}
        {previewMode && (
          <div class="mt-12 lg:mt-0">
            <ReviewPanel slug={slug} title={title} isDraft={isDraft} approvedAt={approvedAt} />
          </div>
        )}
      </div>
    </div>

    {
      related.length > 0 && (
        <div class="container-wide mt-28">
          <p class="eyebrow reveal">More from the journal</p>
          <div class="mt-12 grid gap-12 md:grid-cols-3">
            {related.map((p, i) => (
              <div class="reveal" style={`transition-delay: ${i * 100}ms;`}>
                <BlogCard
                  title={p.title}
                  excerpt={p.description}
                  category={p.category}
                  href={`/journal/${p.slug}`}
                  publishedAt={p.publishedAt}
                />
              </div>
            ))}
          </div>
        </div>
      )
    }
  </article>

  {/* ReviewPanel is now rendered inside the article grid above (previewMode only). */}
</BaseLayout>

<style>
  /* Drop cap on the first paragraph — design system, section 3. */
  .post-body > :global(p:first-of-type)::first-letter {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--color-rust);
    font-size: 5.5rem;
    line-height: 0.85;
    float: left;
    padding: 0.25rem 0.75rem 0 0;
  }

  .post-body :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-body :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(20px, 2vw, 26px);
    line-height: 1.2;
    color: var(--color-ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-body :global(a) {
    color: var(--color-rust);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin: 1.25rem 0;
    padding-left: 1.4rem;
    list-style: revert;
  }

  .post-body :global(li) {
    margin: 0.4rem 0;
  }

  .post-body :global(blockquote) {
    margin: 2rem 0;
    padding-left: 1.5rem;
    border-left: 2px solid var(--color-rust);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.4;
    color: var(--color-ink);
  }

  .post-body :global(img) {
    width: 100%;
    height: auto;
    margin: 2.5rem 0;
  }
</style>
