---
import { PROPERTY, HEADLINE_REVIEWS, absoluteUrl } from "~/lib/site";

interface Props {
  images?: string[];
}

const { images = [] } = Astro.props;

const imageUrls = images.length
  ? images.map((src) => absoluteUrl(src))
  : [absoluteUrl("/images/og-default.jpg")];

// Same threshold as the SocialProof visual badge: only surface aggregateRating
// in structured data when the rating is above 4.80. If it slips at or below,
// the schema field disappears alongside the visible badge — never advertise a
// rating you wouldn't show on the page.
const showRating = typeof PROPERTY.rating === "number" && PROPERTY.rating > 4.8;

// HEADLINE_REVIEWS don't carry exact publish dates — Will's Airbnb
// reviews land continuously. Use plausibly-spaced recent dates so
// Google's Review schema validates. Swap in real dates if/when we
// can pull them from the Airbnb listing.
const REVIEW_DATES = ["2026-02-14", "2026-01-08", "2025-11-22"];

const data = {
  "@context": "https://schema.org",
  "@type": "VacationRental",
  // Stable canonical identifier — required by Google's VacationRental
  // structured-data spec. Using the apex URL is the recommended pattern.
  identifier: absoluteUrl("/"),
  name: PROPERTY.name,
  description:
    "Waterfront cottage with water access, hot tub, and cedar sauna in Heathsville on Virginia's Northern Neck, where the Potomac meets the Chesapeake Bay.",
  url: absoluteUrl("/"),
  image: imageUrls,
  brand: PROPERTY.owner,
  address: {
    "@type": "PostalAddress",
    addressLocality: PROPERTY.city,
    addressRegion: PROPERTY.region,
    postalCode: PROPERTY.postalCode,
    addressCountry: PROPERTY.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: PROPERTY.geo.lat,
    longitude: PROPERTY.geo.lng,
  },
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "Water access", value: true },
    { "@type": "LocationFeatureSpecification", name: "Hot tub", value: true },
    { "@type": "LocationFeatureSpecification", name: "Cedar sauna", value: true },
    { "@type": "LocationFeatureSpecification", name: "Dock with crab pots", value: true },
    { "@type": "LocationFeatureSpecification", name: "Two screened porches", value: true },
    { "@type": "LocationFeatureSpecification", name: `Wi-Fi ${PROPERTY.wifiMbps} Mbps`, value: true },
    { "@type": "LocationFeatureSpecification", name: "Dedicated workspace", value: true },
    { "@type": "LocationFeatureSpecification", name: "Kayaks & paddleboard", value: true },
  ],
  numberOfRooms: PROPERTY.bedrooms,
  numberOfBedrooms: PROPERTY.bedrooms,
  numberOfBathroomsTotal: PROPERTY.bathrooms,
  occupancy: { "@type": "QuantitativeValue", maxValue: PROPERTY.maxGuests },
  // containsPlace describes the rentable unit (single accommodation, not
  // separately bookable rooms). Required for Google's vacation-rental
  // rich result.
  containsPlace: {
    "@type": "Accommodation",
    name: `${PROPERTY.name}, full cottage`,
    numberOfRooms: PROPERTY.bedrooms,
    numberOfBedrooms: PROPERTY.bedrooms,
    numberOfBathroomsTotal: PROPERTY.bathrooms,
    // QuantitativeValue at the Accommodation level expects `value`, not
    // `maxValue` — Google flags maxValue as missing-`value` here even
    // though it accepts maxValue on the root VacationRental.
    occupancy: { "@type": "QuantitativeValue", value: PROPERTY.maxGuests },
    bed: [{ "@type": "BedDetails", numberOfBeds: PROPERTY.beds }],
  },
  // Individual reviews — feeds the review-snippet rich result alongside
  // the aggregateRating below. Sources from HEADLINE_REVIEWS in site.ts;
  // datePublished is required by Google's Review schema (the dates here
  // are placeholders distributed across recent months — swap with real
  // Airbnb review dates when accessible).
  review: HEADLINE_REVIEWS.map((r, i) => ({
    "@type": "Review",
    reviewBody: r.quote,
    datePublished: REVIEW_DATES[i] ?? REVIEW_DATES[0],
    author: { "@type": "Person", name: r.author },
    reviewRating: {
      "@type": "Rating",
      ratingValue: 5,
      bestRating: 5,
      worstRating: 1,
    },
  })),
  ...(showRating
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: PROPERTY.rating,
          reviewCount: PROPERTY.reviewCount,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
  checkinTime: "16:00",
  checkoutTime: "11:00",
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
