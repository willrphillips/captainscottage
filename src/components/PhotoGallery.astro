---
import { withBase } from "~/lib/site";

// Asymmetric 7-tile grid. Each tile maps to one image slot in /public/images/.
// When real photos arrive, drop them at these paths (or update the manifest).
const photos = [
  {
    src: "/images/cottage-exterior-creek.jpg",
    alt: "Captain's Cottage exterior in Heathsville, Virginia — Adirondack chair on the deck and Hull Creek visible just beyond the trees.",
    span: "md:col-span-7 md:row-span-2",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/stairs-to-dock.jpg",
    alt: "Wooden stairs descending from the cottage down to the private dock and Hull Creek.",
    span: "md:col-span-5",
    aspect: "aspect-[4/5]",
  },
  {
    src: "/images/living-room-rattan.jpg",
    alt: "Living room at Captain's Cottage — rattan chairs, a vintage red rug, and the dining nook beyond.",
    span: "md:col-span-5",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/screened-porch-dining.jpg",
    alt: "Wooden dining table on the screened porch at Captain's Cottage, with pendant lights and white siding.",
    span: "md:col-span-6",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/kitchen-green-cabinets.jpg",
    alt: "Kitchen at Captain's Cottage — deep-green cabinets, open shelving, brass faucet, and the house manual on the counter.",
    span: "md:col-span-6",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/master-bedroom.jpg",
    alt: "Master bedroom at Captain's Cottage with a mahogany four-poster bed, wicker trunk, and a framed beach painting above the headboard.",
    span: "md:col-span-7",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/dock-hull-creek.jpg",
    alt: "Private dock at Captain's Cottage extending into Hull Creek, with a sandbar visible mid-creek and a far tree line on the opposite shore.",
    span: "md:col-span-5",
    aspect: "aspect-[3/2]",
  },
];
---

<section class="section-pad">
  <div class="container-wide">
    <header class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">A look around</p>
        <h2 class="mt-6 font-display display-xl max-w-[14ch]">
          Three bedrooms. <em>One long view</em>.
        </h2>
      </div>
      <a href={withBase("/the-cottage")} class="btn btn-ghost self-start">
        See the full cottage →
      </a>
    </header>

    <div class="mt-16 grid gap-4 md:grid-cols-12">
      {
        photos.map((p, i) => (
          <figure class:list={["overflow-hidden bg-bone-deep reveal", p.span]} style={`transition-delay: ${i * 60}ms;`}>
            <div class={`${p.aspect} relative w-full`}>
              <img
                src={withBase(p.src)}
                alt={p.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]"
                onerror="this.parentElement.classList.add('placeholder')"
              />
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Placeholder styling when the image file isn't present yet */
  figure .placeholder,
  figure div.placeholder {
    background: linear-gradient(135deg, #d9c9a8 0%, #ebe2d1 100%);
  }
  figure :global(img[src]):not([src=""]) {
    background: linear-gradient(135deg, #d9c9a8 0%, #ebe2d1 100%);
  }
</style>
