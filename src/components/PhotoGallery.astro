---
import { withBase } from "~/lib/site";

// Asymmetric 7-tile grid. Each tile maps to one image slot in /public/images/.
// When real photos arrive, drop them at these paths (or update the manifest).
const photos = [
  {
    src: "/images/cedar-sauna-creek-sunset.jpg",
    alt: "The cedar barrel sauna at Captain's Cottage on Hull Creek, lit by late-afternoon sun with the creek and treeline behind.",
    span: "md:col-span-7",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/stairs-to-dock.jpg",
    alt: "Wooden stairs descending from the cottage down to the private dock and Hull Creek at golden hour.",
    span: "md:col-span-5",
    aspect: "aspect-[4/5]",
  },
  {
    src: "/images/living-room-rattan.jpg",
    alt: "Living room at Captain's Cottage — a grey sofa flanked by rattan armchairs on a vintage rug, soft lamplight, a framed landscape above.",
    span: "md:col-span-5",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/screened-porch-dining.jpg",
    alt: "Wooden dining table on the screened porch at Captain's Cottage, with pendant lights and white siding.",
    span: "md:col-span-6",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/kitchen-green-cabinets.jpg",
    alt: "Kitchen at Captain's Cottage — deep-green cabinets, open shelving, a brass faucet, and a window over the sink.",
    span: "md:col-span-6",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/master-bedroom.jpg",
    alt: "Master bedroom at Captain's Cottage with a mahogany four-poster bed, a wicker trunk at its foot, and the ensuite bath just beyond.",
    span: "md:col-span-7",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/dock-hull-creek.jpg",
    alt: "Private dock at Captain's Cottage reaching out into Hull Creek, the far tree line on the opposite shore beyond.",
    span: "md:col-span-5",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/hot-tub-hull-creek.jpg",
    alt: "Hot tub and a paver fire-pit circle on the patio at Captain's Cottage, Hull Creek beyond in golden evening light.",
    span: "md:col-span-7",
    aspect: "aspect-[3/2]",
  },
];
---

<section class="section-pad">
  <div class="container-wide">
    <header class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">A look around</p>
        <h2 class="mt-6 font-display display-xl max-w-[14ch]">
          Three bedrooms. <em>One long view</em>.
        </h2>
      </div>
      <a href={withBase("/the-cottage")} class="btn btn-ghost self-start">
        See the full cottage →
      </a>
    </header>

    <div class="mt-16 grid gap-4 md:grid-cols-12 md:auto-rows-[clamp(220px,22vw,340px)]" data-gallery>
      {
        photos.map((p, i) => (
          <figure
            class:list={["overflow-hidden bg-bone-deep reveal aspect-[3/2] md:aspect-auto", p.span]}
            style={`transition-delay: ${i * 60}ms;`}
          >
            <button
              type="button"
              class="block h-full w-full cursor-zoom-in"
              data-lightbox-index={i}
              aria-label={`Open photo ${i + 1}: ${p.alt}`}
            >
              <img
                src={withBase(p.src)}
                alt={p.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]"
                onerror="this.parentElement.classList.add('placeholder')"
              />
            </button>
          </figure>
        ))
      }
    </div>
  </div>
</section>

{/* Lightbox — full-page modal viewer for the gallery. Vanilla JS, no
    dependencies. Esc/← →/click-backdrop/X to close+navigate. */}
<div
  id="gallery-lightbox"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-ink/95 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Photo viewer"
  aria-hidden="true"
>
  <button
    type="button"
    id="gl-close"
    aria-label="Close photo viewer"
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-bone/10 text-bone hover:bg-bone/20 md:right-6 md:top-6"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
    </svg>
  </button>

  <button
    type="button"
    id="gl-prev"
    aria-label="Previous photo"
    class="absolute left-3 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-bone/10 text-bone hover:bg-bone/20 md:left-6 md:h-14 md:w-14"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"/>
    </svg>
  </button>

  <button
    type="button"
    id="gl-next"
    aria-label="Next photo"
    class="absolute right-3 top-1/2 z-10 flex h-12 w-12 -translate-y-1/2 items-center justify-center rounded-full bg-bone/10 text-bone hover:bg-bone/20 md:right-6 md:h-14 md:w-14"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true">
      <path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M9 6l6 6-6 6"/>
    </svg>
  </button>

  <figure class="flex max-h-[80vh] max-w-[80vw] flex-col items-center justify-center">
    <img id="gl-image" src="" alt="" class="max-h-[80vh] max-w-[80vw] object-contain shadow-2xl" />
    <figcaption id="gl-caption" class="mt-4 max-w-[80vw] text-center text-sm text-bone/70"></figcaption>
  </figure>
</div>

<script is:inline>
  (function () {
    var gallery = document.querySelector("[data-gallery]");
    var modal = document.getElementById("gallery-lightbox");
    if (!gallery || !modal) return;
    var imgEl = document.getElementById("gl-image");
    var capEl = document.getElementById("gl-caption");
    var closeBtn = document.getElementById("gl-close");
    var prevBtn = document.getElementById("gl-prev");
    var nextBtn = document.getElementById("gl-next");

    var photos = Array.prototype.slice.call(gallery.querySelectorAll("img"));
    if (!photos.length) return;

    var current = 0;
    var lastFocused = null;

    function show(i) {
      current = (i + photos.length) % photos.length;
      var p = photos[current];
      imgEl.src = p.src;
      imgEl.alt = p.alt || "";
      capEl.textContent = p.alt || "";
    }
    function open(i) {
      lastFocused = document.activeElement;
      show(i);
      modal.classList.remove("hidden");
      modal.classList.add("flex");
      modal.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";
      closeBtn.focus();
    }
    function close() {
      modal.classList.add("hidden");
      modal.classList.remove("flex");
      modal.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      imgEl.src = "";
      if (lastFocused && lastFocused.focus) lastFocused.focus();
    }

    gallery.addEventListener("click", function (e) {
      var btn = e.target.closest("[data-lightbox-index]");
      if (!btn) return;
      var i = parseInt(btn.getAttribute("data-lightbox-index"), 10);
      if (!isNaN(i)) open(i);
    });

    closeBtn.addEventListener("click", close);
    prevBtn.addEventListener("click", function () { show(current - 1); });
    nextBtn.addEventListener("click", function () { show(current + 1); });

    modal.addEventListener("click", function (e) {
      // Close when clicking the backdrop (not the image, caption, or buttons)
      if (e.target === modal) close();
    });

    document.addEventListener("keydown", function (e) {
      if (modal.classList.contains("hidden")) return;
      if (e.key === "Escape") { e.preventDefault(); close(); }
      else if (e.key === "ArrowLeft") { e.preventDefault(); show(current - 1); }
      else if (e.key === "ArrowRight") { e.preventDefault(); show(current + 1); }
    });
  })();
</script>

<style>
  /* Placeholder styling when the image file isn't present yet */
  figure .placeholder,
  figure div.placeholder {
    background: linear-gradient(135deg, #d9c9a8 0%, #ebe2d1 100%);
  }
  figure :global(img[src]):not([src=""]) {
    background: linear-gradient(135deg, #d9c9a8 0%, #ebe2d1 100%);
  }
</style>
