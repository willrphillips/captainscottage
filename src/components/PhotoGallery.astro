---
import { withBase } from "~/lib/site";

// Asymmetric 7-tile grid. Each tile maps to one image slot in /public/images/.
// When real photos arrive, drop them at these paths (or update the manifest).
const photos = [
  {
    src: "/images/cottage-exterior-creek.jpg",
    alt: "Captain's Cottage exterior on Hull Creek, screened porch and water beyond.",
    span: "md:col-span-7 md:row-span-2",
    aspect: "aspect-[4/3]",
  },
  {
    src: "/images/dock-sunset-creek.jpg",
    alt: "Private dock on Hull Creek at sunset, west-facing gold light over the water.",
    span: "md:col-span-5",
    aspect: "aspect-[4/5]",
  },
  {
    src: "/images/sauna-cedar-window.jpg",
    alt: "Cedar sauna interior with a window onto Hull Creek and the dock.",
    span: "md:col-span-5",
    aspect: "aspect-[4/3]",
  },
  {
    src: "/images/screened-porch-dining.jpg",
    alt: "Screened porch set for dinner overlooking Hull Creek at golden hour.",
    span: "md:col-span-6",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/hot-tub-deck.jpg",
    alt: "Hot tub on the deck at Captain's Cottage with sunset light and creek view.",
    span: "md:col-span-6",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/master-bedroom.jpg",
    alt: "Master bedroom at Captain's Cottage with bay window and dedicated workspace.",
    span: "md:col-span-7",
    aspect: "aspect-[3/2]",
  },
  {
    src: "/images/private-beach-shallow.jpg",
    alt: "Private brackish beach at Captain's Cottage, shallow water and a sandy entry.",
    span: "md:col-span-5",
    aspect: "aspect-[4/5]",
  },
];
---

<section class="section-pad">
  <div class="container-wide">
    <header class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">A look around</p>
        <h2 class="mt-6 font-display display-xl max-w-[14ch]">
          Three bedrooms. <em>One long view</em>.
        </h2>
      </div>
      <a href={withBase("/the-cottage")} class="btn btn-ghost self-start">
        See the full cottage →
      </a>
    </header>

    <div class="mt-16 grid gap-4 md:grid-cols-12">
      {
        photos.map((p, i) => (
          <figure class:list={["overflow-hidden bg-bone-deep reveal", p.span]} style={`transition-delay: ${i * 60}ms;`}>
            <div class={`${p.aspect} relative w-full`}>
              <img
                src={withBase(p.src)}
                alt={p.alt}
                loading="lazy"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.02]"
                onerror="this.parentElement.classList.add('placeholder')"
              />
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Placeholder styling when the image file isn't present yet */
  figure .placeholder,
  figure div.placeholder {
    background: linear-gradient(135deg, #d9c9a8 0%, #ebe2d1 100%);
  }
  figure :global(img[src]):not([src=""]) {
    background: linear-gradient(135deg, #d9c9a8 0%, #ebe2d1 100%);
  }
</style>
