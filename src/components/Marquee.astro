---
// Static amenity strip. Was a scrolling marquee that doubled its items in
// the DOM for a seamless loop — the doubling caused visible duplicates
// (Will flagged "cedar sauna" appearing twice). Dropped the animation so
// each item shows once. Centered, wraps on narrow screens.
const items = [
  "waterfront",
  "cedar sauna",
  "hot tub",
  "private dock",
  "two screened porches",
];
---

<section class="border-y border-rule bg-bone-deep py-6">
  <div class="container-wide">
    <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 md:gap-x-10">
      {
        items.map((label, i) => (
          <>
            {i > 0 && (
              <li aria-hidden="true" class="font-display text-ink-soft/50 text-2xl md:text-3xl">·</li>
            )}
            <li class="font-display italic text-rust text-2xl md:text-3xl">{label}</li>
          </>
        ))
      }
    </ul>
  </div>
</section>
