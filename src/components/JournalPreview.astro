---
import { getCollection } from "astro:content";
import BlogCard from "~/components/BlogCard.astro";
import { withBase } from "~/lib/site";

// Pulls the three most recent NON-DRAFT posts from the blog collection so
// the home page never points at a draft (which would 404 in production).
// If nothing is published yet, the section quietly hides.
let posts: { title: string; excerpt: string; category: "Lifestyle" | "Travel" | "Real Estate"; href: string; publishedAt: Date }[] = [];
try {
  const all = await getCollection("blog", ({ data }) => !data.draft);
  posts = all
    .sort((a, b) => +b.data.publishedAt - +a.data.publishedAt)
    .slice(0, 3)
    .map((p) => ({
      title: p.data.title,
      excerpt: p.data.description,
      category: p.data.category,
      href: `/journal/${p.id}`,
      publishedAt: p.data.publishedAt,
    }));
} catch {
  posts = [];
}
---

{
  posts.length > 0 && (
    <section class="section-pad">
      <div class="container-wide">
        <header class="reveal flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow">The journal</p>
            <h2 class="mt-6 font-display display-xl max-w-[16ch]">
              Notes from the <em>Northern Neck</em>.
            </h2>
          </div>
          <a href={withBase("/journal")} class="btn btn-ghost self-start">
            Read the journal →
          </a>
        </header>

        <div class="mt-16 grid gap-12 md:grid-cols-3">
          {posts.map((p, i) => (
            <div class="reveal" style={`transition-delay: ${i * 100}ms;`}>
              <BlogCard {...p} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}
