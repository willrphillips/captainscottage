---
// Preview-only review overlay. BlogPost renders this ONLY when previewMode
// is true (npm run dev, or an INCLUDE_DRAFTS build). It is NEVER emitted in
// the production GitHub Pages build, so nothing here can appear on the live
// site — by design.
import { getCollection } from "astro:content";
import { withBase } from "~/lib/site";

interface Props {
  slug: string;
  title: string;
  isDraft?: boolean;
}
const { slug, title, isDraft = false } = Astro.props;

// Pending-review queue: every draft post is awaiting Will's approval.
let pending: { slug: string; title: string }[] = [];
try {
  const drafts = await getCollection("blog", ({ data }) => data.draft === true);
  drafts.sort((a, b) => +a.data.publishedAt - +b.data.publishedAt);
  pending = drafts.map((p) => ({ slug: p.id, title: p.data.title }));
} catch {
  pending = [];
}

const currentIndex = pending.findIndex((p) => p.slug === slug);
const total = pending.length;
const position = currentIndex >= 0 ? currentIndex + 1 : 0;
const prev =
  currentIndex > 0
    ? pending[currentIndex - 1]
    : currentIndex === 0 && total > 1
      ? pending[total - 1]
      : null;
const next =
  currentIndex >= 0 && currentIndex < total - 1
    ? pending[currentIndex + 1]
    : currentIndex === total - 1 && total > 1
      ? pending[0]
      : null;
---

<aside
  id="admin-overlay"
  data-slug={slug}
  data-title={title}
  data-draft={String(isDraft)}
  class="fixed bottom-4 right-4 z-[70] w-[min(92vw,440px)] rounded-md border border-rule bg-bone shadow-lg"
>
  <button
    type="button"
    id="ao-toggle"
    class="flex w-full items-center justify-between gap-3 rounded-t-md bg-ink px-4 py-3 text-left text-bone"
  >
    <span class="text-xs font-medium uppercase tracking-[0.18em]">
      Review panel{isDraft ? " · draft" : ""}
    </span>
    <span class="flex items-center gap-3 text-bone/70">
      {
        total > 0 && currentIndex >= 0 && (
          <span class="text-[11px] uppercase tracking-[0.18em]">
            {position} / {total}
          </span>
        )
      }
      <span id="ao-caret">▾</span>
    </span>
  </button>

  <div id="ao-body" class="space-y-4 p-4">
    {/* Nav between pending posts */}
    {
      total > 1 && (
        <div class="flex items-center justify-between text-xs text-ink-soft">
          {prev ? (
            <a
              href={withBase("/journal/" + prev.slug)}
              class="flex items-center gap-1 hover:text-ink"
              title={prev.title}
            >
              ← Prev
            </a>
          ) : (
            <span class="text-ink-soft/40">← Prev</span>
          )}
          <span class="text-ink-soft/70">
            {position > 0 ? `${position} of ${total} drafts pending` : `${total} drafts pending`}
          </span>
          {next ? (
            <a
              href={withBase("/journal/" + next.slug)}
              class="flex items-center gap-1 hover:text-ink"
              title={next.title}
            >
              Next →
            </a>
          ) : (
            <span class="text-ink-soft/40">Next →</span>
          )}
        </div>
      )
    }

    {/* Pending-rewrite banner — toggled by JS via localStorage flag */}
    <div
      id="ao-pending"
      style="display:none"
      class="rounded border border-sage bg-sage/10 px-3 py-2 text-xs text-sage"
    >
      <div class="flex items-start justify-between gap-3">
        <span>
          ✓ Feedback submitted — <strong>rewrite pending</strong>. The Writer agent will pick this up on the next run.
        </span>
        <button
          type="button"
          id="ao-clear-pending"
          class="shrink-0 underline hover:no-underline"
          title="Clear the local 'pending' flag (does not affect the saved feedback file)"
        >
          clear
        </button>
      </div>
    </div>

    <p class="text-sm text-ink-soft">
      Reviewing <strong>{title}</strong>. Your feedback is saved as a file the writing agents read on their next run. Nothing here publishes.
    </p>

    <div class="flex gap-2">
      <label class="flex-1">
        <input type="radio" name="ao-decision" value="request-changes" checked class="peer sr-only" />
        <span class="block cursor-pointer rounded border border-rule px-3 py-2 text-center text-sm peer-checked:border-rust peer-checked:bg-rust/10 peer-checked:text-rust-deep">
          Request changes
        </span>
      </label>
      <label class="flex-1">
        <input type="radio" name="ao-decision" value="approve-for-batch" class="peer sr-only" />
        <span class="block cursor-pointer rounded border border-rule px-3 py-2 text-center text-sm peer-checked:border-sage peer-checked:bg-sage/10 peer-checked:text-sage">
          Approve for batch
        </span>
      </label>
    </div>

    <textarea
      id="ao-feedback"
      rows="5"
      placeholder="What should change? Be specific — section, sentence, fact to fix. (Ctrl+Enter to submit. Approving for batch records the decision; final publish is still your gate.)"
      class="w-full resize-y rounded border border-rule bg-white p-3 text-sm text-ink outline-none focus:border-ink"
    ></textarea>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="ao-submit"
        class="btn btn-rust !px-4 !py-2 text-sm"
      >
        Submit feedback
      </button>
      <span class="text-[11px] text-ink-soft/60">⌘/Ctrl + Enter</span>
      <span id="ao-status" class="ml-auto text-xs text-sage"></span>
    </div>

    <p class="text-xs text-ink-soft/70">
      Submitting writes <code>content/feedback/{slug}.json</code> straight into the project. Dev review only — never bundled into the production site.
    </p>
  </div>
</aside>

<script is:inline>
  (function () {
    var root = document.getElementById("admin-overlay");
    if (!root) return;
    var slug = root.getAttribute("data-slug");
    var title = root.getAttribute("data-title");
    var isDraft = root.getAttribute("data-draft") === "true";
    var body = document.getElementById("ao-body");
    var caret = document.getElementById("ao-caret");
    var statusEl = document.getElementById("ao-status");
    var pendingBanner = document.getElementById("ao-pending");
    var clearBtn = document.getElementById("ao-clear-pending");

    document.getElementById("ao-toggle").addEventListener("click", function () {
      var hidden = body.style.display === "none";
      body.style.display = hidden ? "" : "none";
      caret.textContent = hidden ? "▾" : "▸";
    });

    // Persist textarea across HMR reloads.
    var STORE_KEY = "ao-feedback:" + slug;
    var PENDING_KEY = "ao-pending:" + slug;
    var ta = document.getElementById("ao-feedback");

    try {
      var saved = JSON.parse(localStorage.getItem(STORE_KEY) || "null");
      if (saved) {
        if (typeof saved.feedback === "string") ta.value = saved.feedback;
        if (saved.decision) {
          var r = document.querySelector('input[name="ao-decision"][value="' + saved.decision + '"]');
          if (r) r.checked = true;
        }
      }
    } catch (e) {}

    // Show the "rewrite pending" banner if we previously submitted feedback
    // for this slug and haven't cleared it yet.
    function refreshPendingBanner() {
      try {
        if (localStorage.getItem(PENDING_KEY)) {
          pendingBanner.style.display = "";
        } else {
          pendingBanner.style.display = "none";
        }
      } catch (e) {}
    }
    refreshPendingBanner();

    if (clearBtn) {
      clearBtn.addEventListener("click", function () {
        try { localStorage.removeItem(PENDING_KEY); } catch (e) {}
        refreshPendingBanner();
      });
    }

    function persist() {
      try {
        localStorage.setItem(STORE_KEY, JSON.stringify({
          feedback: ta.value,
          decision: (document.querySelector('input[name="ao-decision"]:checked') || {}).value || "request-changes"
        }));
      } catch (e) {}
    }
    ta.addEventListener("input", persist);
    Array.prototype.forEach.call(
      document.querySelectorAll('input[name="ao-decision"]'),
      function (el) { el.addEventListener("change", persist); }
    );

    function payload() {
      var decision = (document.querySelector('input[name="ao-decision"]:checked') || {}).value || "request-changes";
      return {
        slug: slug,
        title: title,
        isDraft: isDraft,
        decision: decision,
        feedback: ta.value.trim(),
        reviewer: "Will Phillips",
        at: new Date().toISOString(),
        note: "Captured in the preview review panel. Agents consume content/feedback/<slug>.json. 'approve-for-batch' records intent only; publishing remains gated."
      };
    }

    function flash(msg) {
      statusEl.textContent = msg;
      clearTimeout(flash._t);
      flash._t = setTimeout(function () { statusEl.textContent = ""; }, 4000);
    }

    var submitBtn = document.getElementById("ao-submit");

    function doSubmit() {
      var data = payload();
      if (data.decision === "request-changes" && !data.feedback) {
        flash("Add a note first.");
        return;
      }
      submitBtn.disabled = true;
      flash("Submitting…");
      fetch("/__feedback", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify(data),
      })
        .then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
          submitBtn.disabled = false;
          if (res.ok && res.j && res.j.ok) {
            try {
              localStorage.removeItem(STORE_KEY);
              localStorage.setItem(PENDING_KEY, new Date().toISOString());
            } catch (e) {}
            ta.value = "";
            refreshPendingBanner();
            flash("Submitted → " + res.j.path);
          } else {
            flash("Failed: " + ((res.j && res.j.error) || "server") + ". Downloading instead.");
            downloadFallback(data);
          }
        })
        .catch(function () {
          submitBtn.disabled = false;
          flash("No dev server. Downloading instead.");
          downloadFallback(data);
        });
    }

    submitBtn.addEventListener("click", doSubmit);

    // Ctrl/Cmd + Enter shortcut from within the textarea.
    ta.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        doSubmit();
      }
    });

    function downloadFallback(data) {
      var blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "feedback-" + slug + ".json";
      a.click();
      URL.revokeObjectURL(a.href);
    }
  })();
</script>
