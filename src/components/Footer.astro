---
import { NAV_LINKS, PROPERTY, SITE, withBase } from "~/lib/site";
const year = new Date().getFullYear();
---

<footer class="bg-navy text-bone">
  <div class="container-wide py-20 md:py-28">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="eyebrow text-sand">The Northern Neck · Virginia</p>
        <p class="mt-6 font-display text-4xl leading-[1.05] md:text-5xl">
          Stay with us. <em>The water is waiting.</em>
        </p>
        <a href={withBase("/book")} class="btn btn-rust mt-10">
          Check availability
        </a>
      </div>

      <div>
        <p class="eyebrow text-sand">Explore</p>
        <ul class="mt-6 space-y-3 text-sm">
          {
            NAV_LINKS.map((link) => (
              <li>
                <a href={withBase(link.href)} class="text-bone/85 hover:text-bone">
                  {link.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href={withBase("/what-to-bring")} class="text-bone/85 hover:text-bone">
              What to Bring
            </a>
          </li>
          <li>
            <a href={withBase("/privacy")} class="text-bone/85 hover:text-bone">
              Privacy
            </a>
          </li>
        </ul>
      </div>

      <div class="text-sm text-bone/80">
        <p class="eyebrow text-sand">{PROPERTY.name}</p>
        <p class="mt-6">{PROPERTY.city}, {PROPERTY.region} {PROPERTY.postalCode}</p>
        <p>On {PROPERTY.waterway}, off the Potomac.</p>
        <p class="mt-4">
          <a href={PROPERTY.airbnbUrl} rel="noopener noreferrer" target="_blank" class="text-bone hover:text-rust">
            Message us on Airbnb →
          </a>
        </p>
      </div>
    </div>

    {/* Email capture — hidden until SITE.newsletterAction is set (Buttondown).
        Quiet by design: the footer's bold element is the "Stay with us" display
        above; this is a low-key standing invitation, not a pop-up. */}
    {SITE.newsletterAction && (
      <div class="mt-16 border-t border-bone/15 pt-10">
        <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
          <div>
            <p class="eyebrow text-sand">Notes from the Northern Neck</p>
            <p class="mt-3 max-w-[36rem] text-sm text-bone/80">
              An occasional letter about life out here: the water, the
              seasons, the small things worth a weekend. No noise, easy to leave.
            </p>
          </div>
          <form
            action={SITE.newsletterAction}
            method="post"
            target="_blank"
            class="flex w-full max-w-md gap-2"
          >
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input
              id="newsletter-email"
              type="email"
              name="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="min-w-0 flex-1 rounded-full border border-bone/25 bg-transparent px-5 py-2.5 text-sm text-bone placeholder:text-bone/40 focus:border-bone/60 focus:outline-none"
            />
            <button type="submit" class="btn btn-rust shrink-0">Subscribe</button>
          </form>
        </div>
      </div>
    )}

    <div class="mt-16 flex flex-col gap-2 border-t border-bone/15 pt-8 text-xs text-bone/55 md:flex-row md:items-center md:justify-between">
      <p>© {year} {PROPERTY.owner}. All rights reserved.</p>
      <p>Hosted on the Northern Neck since {PROPERTY.cottageAcquiredYear}.</p>
    </div>
  </div>
</footer>
