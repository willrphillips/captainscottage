---
// Preview-only review overlay. BlogPost renders this ONLY when previewMode
// is true (npm run dev, or an INCLUDE_DRAFTS build). It is never emitted in
// the production GitHub Pages build, so it cannot appear on the live site.
//
// A static site cannot run agents or write files from the browser. So this
// overlay CAPTURES a review decision + feedback and hands it back as a JSON
// file (download + clipboard). You drop that into content/feedback/<slug>.json
// (or commit it via the Git CMS). The Writer/SEO agents read that file on
// their next run and revise. "Automatic" = the loop is wired; a run still
// has to be triggered. This is the honest boundary.
interface Props {
  slug: string;
  title: string;
  isDraft?: boolean;
}
const { slug, title, isDraft = false } = Astro.props;
---

<aside
  id="admin-overlay"
  data-slug={slug}
  data-title={title}
  data-draft={String(isDraft)}
  class="fixed bottom-4 right-4 z-[70] w-[min(92vw,420px)] rounded-md border border-rule bg-bone shadow-lg"
>
  <button
    type="button"
    id="ao-toggle"
    class="flex w-full items-center justify-between gap-3 rounded-t-md bg-ink px-4 py-3 text-left text-bone"
  >
    <span class="text-xs font-medium uppercase tracking-[0.18em]">
      Review panel{isDraft ? " · draft" : ""}
    </span>
    <span id="ao-caret" class="text-bone/70">▾</span>
  </button>

  <div id="ao-body" class="space-y-4 p-4">
    <p class="text-sm text-ink-soft">
      Reviewing <strong>{title}</strong>. Your feedback is saved as a file the
      writing agents read on their next run. Nothing here publishes.
    </p>

    <div class="flex gap-2">
      <label class="flex-1">
        <input type="radio" name="ao-decision" value="request-changes" checked class="peer sr-only" />
        <span class="block cursor-pointer rounded border border-rule px-3 py-2 text-center text-sm peer-checked:border-rust peer-checked:bg-rust/10 peer-checked:text-rust-deep">
          Request changes
        </span>
      </label>
      <label class="flex-1">
        <input type="radio" name="ao-decision" value="approve-for-batch" class="peer sr-only" />
        <span class="block cursor-pointer rounded border border-rule px-3 py-2 text-center text-sm peer-checked:border-sage peer-checked:bg-sage/10 peer-checked:text-sage">
          Approve for batch
        </span>
      </label>
    </div>

    <textarea
      id="ao-feedback"
      rows="5"
      placeholder="What should change? Be specific — section, sentence, fact to fix. (Approving for batch records the decision; final publish is still your gate in the CMS.)"
      class="w-full resize-y rounded border border-rule bg-white p-3 text-sm text-ink outline-none focus:border-ink"
    ></textarea>

    <div class="flex items-center gap-2">
      <button
        type="button"
        id="ao-submit"
        class="btn btn-rust !px-4 !py-2 text-sm"
      >
        Submit feedback
      </button>
      <span id="ao-status" class="text-xs text-sage"></span>
    </div>

    <p class="text-xs text-ink-soft/70">
      Submitting writes <code>content/feedback/{slug}.json</code> straight into
      the project. The Writer/SEO agents read it on the next run. (Dev review
      only — needs the local dev server.)
    </p>
  </div>
</aside>

<script is:inline>
  (function () {
    var root = document.getElementById("admin-overlay");
    if (!root) return;
    var slug = root.getAttribute("data-slug");
    var title = root.getAttribute("data-title");
    var isDraft = root.getAttribute("data-draft") === "true";
    var body = document.getElementById("ao-body");
    var caret = document.getElementById("ao-caret");
    var statusEl = document.getElementById("ao-status");

    document.getElementById("ao-toggle").addEventListener("click", function () {
      var hidden = body.style.display === "none";
      body.style.display = hidden ? "" : "none";
      caret.textContent = hidden ? "▾" : "▸";
    });

    // Persist across the dev server's hot-reloads (file changes during a
    // session trigger HMR, which would otherwise wipe the textarea).
    var STORE_KEY = "ao-feedback:" + slug;
    var ta = document.getElementById("ao-feedback");
    try {
      var saved = JSON.parse(localStorage.getItem(STORE_KEY) || "null");
      if (saved) {
        if (typeof saved.feedback === "string") ta.value = saved.feedback;
        if (saved.decision) {
          var r = document.querySelector('input[name="ao-decision"][value="' + saved.decision + '"]');
          if (r) r.checked = true;
        }
      }
    } catch (e) {}

    function persist() {
      try {
        localStorage.setItem(STORE_KEY, JSON.stringify({
          feedback: ta.value,
          decision: (document.querySelector('input[name="ao-decision"]:checked') || {}).value || "request-changes"
        }));
      } catch (e) {}
    }
    ta.addEventListener("input", persist);
    Array.prototype.forEach.call(
      document.querySelectorAll('input[name="ao-decision"]'),
      function (el) { el.addEventListener("change", persist); }
    );

    function payload() {
      var decision = (document.querySelector('input[name="ao-decision"]:checked') || {}).value || "request-changes";
      return {
        slug: slug,
        title: title,
        isDraft: isDraft,
        decision: decision,
        feedback: document.getElementById("ao-feedback").value.trim(),
        reviewer: "Will Phillips",
        at: new Date().toISOString(),
        note: "Captured in the preview review panel. Agents consume content/feedback/<slug>.json. 'approve-for-batch' records intent only; publishing remains gated in the CMS."
      };
    }

    function flash(msg) {
      statusEl.textContent = msg;
      setTimeout(function () { statusEl.textContent = ""; }, 3000);
    }

    document.getElementById("ao-save").addEventListener("click", function () {
      var data = payload();
      if (data.decision === "request-changes" && !data.feedback) {
        flash("Add a note first.");
        return;
      }
      var blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
      var a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = "feedback-" + slug + ".json";
      a.click();
      URL.revokeObjectURL(a.href);
      try { localStorage.removeItem(STORE_KEY); } catch (e) {}
      flash("Saved. Drop into content/feedback/");
    });

    document.getElementById("ao-copy").addEventListener("click", function () {
      var json = JSON.stringify(payload(), null, 2);
      if (navigator.clipboard) {
        navigator.clipboard.writeText(json).then(function () { flash("Copied."); });
      } else {
        flash("Clipboard unavailable.");
      }
    });
  })();
</script>
