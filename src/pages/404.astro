---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { withBase } from "~/lib/site";
---

<BaseLayout
  title="Off the map | Captain's Cottage"
  description="The page you're after doesn't exist. Let's get you back to the water."
  noindex
>
  <section class="section-pad min-h-[80vh]">
    <div class="container-narrow">
      <p class="eyebrow">404</p>
      <h1 class="mt-8 font-display display-hero max-w-[14ch]">
        Off the <em>map</em>.
      </h1>
      <p class="lede mt-8 max-w-xl">
        The page you're after doesn't exist, at least not yet. Try one of these instead.
      </p>
      <ul class="mt-10 grid gap-3 text-base md:grid-cols-2">
        <li><a href={withBase("/")} class="text-rust underline-offset-4 hover:underline">The cottage (home)</a></li>
        <li><a href={withBase("/the-cottage")} class="text-rust underline-offset-4 hover:underline">A tour, room by room</a></li>
        <li><a href={withBase("/amenities")} class="text-rust underline-offset-4 hover:underline">What's here (amenities)</a></li>
        <li><a href={withBase("/area")} class="text-rust underline-offset-4 hover:underline">The Northern Neck</a></li>
        <li><a href={withBase("/activities")} class="text-rust underline-offset-4 hover:underline">Things to do</a></li>
        <li><a href={withBase("/what-to-bring")} class="text-rust underline-offset-4 hover:underline">What to bring</a></li>
        <li><a href={withBase("/journal")} class="text-rust underline-offset-4 hover:underline">The journal</a></li>
        <li><a href={withBase("/faq")} class="text-rust underline-offset-4 hover:underline">FAQ</a></li>
      </ul>
      <a href={withBase("/book")} class="btn btn-rust mt-12">Stay with us</a>
    </div>
  </section>
</BaseLayout>
