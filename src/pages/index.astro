---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Hero from "~/components/Hero.astro";
import Marquee from "~/components/Marquee.astro";
import StorySection from "~/components/StorySection.astro";
import ReviewQuote from "~/components/ReviewQuote.astro";
import AmenityGrid from "~/components/AmenityGrid.astro";
import PhotoGallery from "~/components/PhotoGallery.astro";
import LocationSection from "~/components/LocationSection.astro";
import JournalPreview from "~/components/JournalPreview.astro";
import BookingCTA from "~/components/BookingCTA.astro";
import SchemaVacationRental from "~/components/SchemaVacationRental.astro";

const title = "Northern Neck Waterfront Vacation Rental | Captain's Cottage";
const description =
  "Captain's Cottage is a waterfront vacation rental on Virginia's Northern Neck: 3 bedrooms, cedar sauna, hot tub, and a dock on Hull Creek. Book on Airbnb.";
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={[{ name: "Home", href: "/" }]}
>
  <SchemaVacationRental
    slot="head"
    images={[
      "/images/hero-porch-creek.jpg",
      "/images/dock-hull-creek.jpg",
      "/images/cottage-exterior-creek.jpg",
      "/images/cedar-sauna-creek-sunset.jpg",
      "/images/cedar-sauna-window.jpg",
      "/images/hot-tub-hull-creek.jpg",
      "/images/screened-porch-dining.jpg",
      "/images/kitchen-green-cabinets.jpg",
      "/images/living-room-rattan.jpg",
      "/images/master-bedroom.jpg",
      "/images/stairs-to-dock.jpg",
    ]}
  />

  <Hero slot="hero" />
  <Marquee />
  <StorySection />
  <ReviewQuote />
  <AmenityGrid />
  <PhotoGallery />
  <LocationSection />
  <JournalPreview />
  <BookingCTA />
</BaseLayout>
