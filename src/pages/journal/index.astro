---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import BlogCard from "~/components/BlogCard.astro";

let posts: CollectionEntry<"blog">[] = [];
try {
  posts = await getCollection("blog", ({ data }) => !data.draft);
} catch {
  posts = [];
}

posts.sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);

const categories = ["Lifestyle", "Travel", "Real Estate"] as const;
const present = categories.filter((c) =>
  posts.some((p) => p.data.category === c),
);
---

<BaseLayout
  title="The Journal — Northern Neck Notes from Captain's Cottage"
  description="Lifestyle, travel, and Northern Neck real estate notes from a waterfront cottage host on Hull Creek in Heathsville, Virginia."
  breadcrumbs={[
    { name: "Home", href: "/" },
    { name: "Journal", href: "/journal" },
  ]}
>
  <section class="section-pad">
    <div class="container-wide">
      <header class="reveal max-w-[40rem]">
        <p class="eyebrow">The journal</p>
        <h1 class="mt-6 font-display display-xl">
          Notes from the <em>Northern Neck</em>.
        </h1>
        <p class="lede mt-8">
          Slow weekends, crabbing mornings, and the honest economics of
          waterfront life — written from the dock.
        </p>
      </header>

      {
        posts.length === 0 ? (
          <p class="body-prose reveal mt-20">
            The first posts are on their way. Check back soon.
          </p>
        ) : (
          <>
            {present.length > 1 && (
              <div
                class="reveal mt-14 flex flex-wrap gap-3"
                data-filter-bar
              >
                <button
                  class="eyebrow rounded-full border border-rule px-4 py-2 transition-colors hover:border-ink"
                  data-filter="all"
                  aria-pressed="true"
                >
                  All
                </button>
                {present.map((c) => (
                  <button
                    class="eyebrow rounded-full border border-rule px-4 py-2 transition-colors hover:border-ink"
                    data-filter={c}
                    aria-pressed="false"
                  >
                    {c}
                  </button>
                ))}
              </div>
            )}

            <div class="mt-16 grid gap-12 md:grid-cols-3" data-post-grid>
              {posts.map((p, i) => (
                <div
                  class="reveal"
                  data-category={p.data.category}
                  style={`transition-delay: ${(i % 3) * 100}ms;`}
                >
                  <BlogCard
                    title={p.data.title}
                    excerpt={p.data.description}
                    category={p.data.category}
                    href={`/journal/${p.id}`}
                    publishedAt={p.data.publishedAt}
                  />
                </div>
              ))}
            </div>
          </>
        )
      }
    </div>
  </section>

  <script is:inline>
    // Progressive enhancement: with JS off, every post stays visible.
    (function () {
      var bar = document.querySelector("[data-filter-bar]");
      if (!bar) return;
      var cards = Array.prototype.slice.call(
        document.querySelectorAll("[data-post-grid] [data-category]"),
      );
      bar.addEventListener("click", function (e) {
        var btn = e.target.closest("[data-filter]");
        if (!btn) return;
        var want = btn.getAttribute("data-filter");
        bar.querySelectorAll("[data-filter]").forEach(function (b) {
          b.setAttribute("aria-pressed", String(b === btn));
        });
        cards.forEach(function (card) {
          var show = want === "all" || card.getAttribute("data-category") === want;
          card.style.display = show ? "" : "none";
        });
      });
    })();
  </script>
</BaseLayout>
