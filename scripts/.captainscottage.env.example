# Copy this to scripts/.captainscottage.env on the Ubuntu box and fill in.
# That real file is gitignored — never commit your tokens.

# Where the repo is checked out on the box
CAPTAINSCOTTAGE_DIR="$HOME/captainscottage"

# Telegram bot delivery (from @BotFather + your chat ID — see WATCH_SETUP.md)
TELEGRAM_BOT_TOKEN="123456789:AA...your-bot-token..."
TELEGRAM_CHAT_ID="123456789"
